# TulaSetu Environment Configuration
# Copy to .env and fill in values

# Django
DJANGO_SECRET_KEY=tulasetu-dev-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
POSTGRES_DB=tulasetu
POSTGRES_USER=tulasetu
POSTGRES_PASSWORD=tulasetu_dev_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Identity Provider (mock|aadhaar|digilocker)
IDENTITY_PROVIDER=mock

# Blockchain Sidecar
BLOCKCHAIN_SIDECAR_URL=http://fabric-sidecar:3001
BLOCKCHAIN_ENABLED=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VERIFY_BASE_URL=http://localhost:3000/verify

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
